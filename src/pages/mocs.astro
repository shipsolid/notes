---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import { byUpdatedDesc, isVisibleNote } from '../lib/notes-query';

const mocs = (await getCollection('notes', (e) => isVisibleNote(e, { noteType: 'moc' }))).sort(byUpdatedDesc);

// Group by topic, preserving insert order (most-recently-updated topic first)
// — identical idiom to notes/index.astro.
const topicMap = new Map<string, typeof mocs>();
for (const note of mocs) {
  const topicDir = note.id.split('/')[0];
  const t = topicDir.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  if (!topicMap.has(t)) topicMap.set(t, []);
  topicMap.get(t)!.push(note);
}
const topics = [...topicMap.keys()];
---

<Page
  title="Maps of Content — Notes — Amit Singh"
  description="Curated hub notes — entry points into deeper topic clusters across the notebook."
>
  <div class="max-w-9xl mx-auto px-6">
      <!-- Header -->
      <div class="mb-12">
        <div class="flex items-center gap-2 text-xs font-mono text-faint mb-4">
          <a href="/notes" class="hover:text-accent transition-colors">Notes</a>
          <span>/</span>
          <span class="text-accent">MOCs</span>
        </div>
        <p class="section-label">MOCs</p>
        <h1 class="text-4xl font-bold text-ink mt-2">Maps of Content</h1>
        <p class="text-muted mt-3 max-w-lg">
          Curated hub notes — entry points into deeper topic clusters, rather than a single note on
          one thing.
        </p>
      </div>

      {mocs.length === 0 ? (
        <div class="card text-center py-16">
          <p class="text-dim font-mono">// No MOCs yet</p>
        </div>
      ) : (
        <div class="space-y-14">
          {topics.map((topic) => {
            const topicNotes = topicMap.get(topic)!;
            return (
              <section>
                <div class="flex items-center justify-between mb-4">
                  <h2 class="text-lg font-semibold text-ink font-mono">
                    <span class="text-accent">#</span> {topic}
                  </h2>
                  <span class="text-xs font-mono text-faint">
                    {topicNotes.length} {topicNotes.length === 1 ? 'note' : 'notes'}
                  </span>
                </div>

                <div class="space-y-3">
                  {topicNotes.map((note) => {
                    const updated = note.data.updated
                      ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(note.data.updated)
                      : null;
                    return (
                      <a
                        href={`/notes/${note.id}`}
                        class="card group flex items-start justify-between gap-4 no-underline hover:-translate-y-0.5"
                      >
                        <div class="min-w-0 flex-1">
                          <h3 class="text-base font-medium text-ink group-hover:text-accent transition-colors leading-snug mb-1">
                            {note.data.title}
                          </h3>
                          {note.data.description && (
                            <p class="text-sm text-dim leading-relaxed line-clamp-1">
                              {note.data.description}
                            </p>
                          )}
                          {note.data.tags.length > 0 && (
                            <div class="flex flex-wrap gap-1.5 mt-2">
                              {note.data.tags.slice(0, 4).map((tag) => (
                                <span class="tag text-[11px] py-0.5">{tag}</span>
                              ))}
                            </div>
                          )}
                        </div>
                        <div class="shrink-0 flex flex-col items-end gap-2">
                          {updated && (
                            <span class="text-xs font-mono text-faint">{updated}</span>
                          )}
                          <svg class="w-4 h-4 text-faint group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                          </svg>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </section>
            );
          })}
        </div>
      )}

      <div class="mt-10">
        <a href="/notes" class="text-sm text-accent hover:text-accent-hover font-mono flex items-center gap-2 transition-colors">
          ← All notes
        </a>
      </div>

    </div>

</Page>
