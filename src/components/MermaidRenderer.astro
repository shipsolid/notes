---
// Shared Mermaid CDN-import + render logic, extracted from the near-identical blocks that used
// to live separately in BlogPost.astro and Note.astro. Exposes `window.__renderMermaid(root?)`
// so pages with dynamically-swapped content (e.g. the flashcards study page) can re-invoke it
// after an `.innerHTML =` swap, scoped to just the new content via `root`.
---
<style is:global>
  .mermaid {
    display: flex;
    justify-content: center;
    padding: 1.5rem 0;
  }
  .mermaid svg {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
</style>

<script is:inline type="module">
  function currentTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  // Mermaid bakes its theme into the rendered SVG at run() time, so a theme
  // toggle needs a full re-render, not just a CSS flip. Two full palettes,
  // not "dark + light overrides," since mermaid's dark theme already covers
  // every variable used below and a partial override would leave stray
  // dark-preset defaults showing through on light backgrounds.
  const THEME_VARS = {
    dark: {
      // Catppuccin Mocha, mirroring the :root tokens in styles/global.css.
      primaryColor: '#313244', // Surface0
      primaryTextColor: '#cdd6f4', // Text
      primaryBorderColor: '#585b70', // Surface2
      lineColor: '#94e2d5', // Teal (the site accent)
      secondaryColor: '#1e1e2e', // Base
      tertiaryColor: '#313244', // Surface0
      background: '#1e1e2e', // Base
      mainBkg: '#313244', // Surface0
      nodeBorder: '#585b70', // Surface2
      clusterBkg: '#181825', // Mantle
      titleColor: '#cdd6f4', // Text
      edgeLabelBackground: '#313244', // Surface0
      // Mindmap/pie section colors: mermaid's dark theme derives these from primaryColor
      // via hue rotation, which can land on light/saturated fills that wash out
      // cScaleLabel text. Pin both explicitly so every mindmap section stays legible.
      cScale0: '#1e3a5f',
      cScale1: '#14532d',
      cScale2: '#581c87',
      cScale3: '#7c2d12',
      cScale4: '#831843',
      cScale5: '#713f12',
      cScale6: '#164e63',
      cScale7: '#3730a3',
      cScaleLabel0: '#cdd6f4',
      cScaleLabel1: '#cdd6f4',
      cScaleLabel2: '#cdd6f4',
      cScaleLabel3: '#cdd6f4',
      cScaleLabel4: '#cdd6f4',
      cScaleLabel5: '#cdd6f4',
      cScaleLabel6: '#cdd6f4',
      cScaleLabel7: '#cdd6f4',
    },
    light: {
      primaryColor: '#f1f5f9',
      primaryTextColor: '#0f172a',
      primaryBorderColor: '#cbd5e1',
      lineColor: '#0f766e',
      secondaryColor: '#f1f5f9',
      tertiaryColor: '#e2e8f0',
      background: '#ffffff',
      mainBkg: '#f1f5f9',
      nodeBorder: '#cbd5e1',
      clusterBkg: '#f8fafc',
      titleColor: '#0f172a',
      edgeLabelBackground: '#f1f5f9',
      // Light-pastel fills (inverse of the dark palette's dark fills), one
      // consistent dark label color across sections — same structure as dark.
      cScale0: '#dbeafe',
      cScale1: '#dcfce7',
      cScale2: '#f3e8ff',
      cScale3: '#ffedd5',
      cScale4: '#fce7f3',
      cScale5: '#fef3c7',
      cScale6: '#cffafe',
      cScale7: '#e0e7ff',
      cScaleLabel0: '#1e293b',
      cScaleLabel1: '#1e293b',
      cScaleLabel2: '#1e293b',
      cScaleLabel3: '#1e293b',
      cScaleLabel4: '#1e293b',
      cScaleLabel5: '#1e293b',
      cScaleLabel6: '#1e293b',
      cScaleLabel7: '#1e293b',
    },
  };

  let mermaidPromise = null;
  function getMermaid() {
    return (mermaidPromise ??= import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(
      ({ default: mermaid }) => {
        const theme = currentTheme();
        mermaid.initialize({
          startOnLoad: false,
          // 'base' for light: an unstyled canvas driven entirely by
          // themeVariables, so no dark-preset default shows through anywhere
          // not explicitly covered above. 'dark' stays as-is for dark mode —
          // it's the existing, already-tested path.
          theme: theme === 'light' ? 'base' : 'dark',
          themeVariables: THEME_VARS[theme],
        });
        return mermaid;
      }
    ));
  }

  async function renderMermaid(root = document) {
    const blocks = root.querySelectorAll('pre[data-language="mermaid"]');
    if (blocks.length === 0) return;
    const mermaid = await getMermaid();
    const nodes = [];
    blocks.forEach((pre) => {
      const div = document.createElement('div');
      div.className = 'mermaid not-prose my-8';
      const source = pre.querySelector('code')?.textContent ?? '';
      // Preserved so a theme toggle can re-render from source — mermaid.run()
      // replaces this div's content with rendered SVG, destroying the original.
      div.dataset.mermaidSource = source;
      div.textContent = source;
      pre.replaceWith(div);
      nodes.push(div);
    });
    await mermaid.run({ nodes });
  }

  async function rerenderAllMermaid() {
    const rendered = document.querySelectorAll('.mermaid[data-mermaid-source]');
    if (!rendered.length) return;
    mermaidPromise = null; // force re-init with the new theme's themeVariables
    const mermaid = await getMermaid();
    const nodes = [...rendered];
    nodes.forEach((div) => {
      div.removeAttribute('data-processed');
      div.textContent = div.dataset.mermaidSource;
    });
    await mermaid.run({ nodes });
  }

  window.__renderMermaid = renderMermaid;
  window.addEventListener('themechange', rerenderAllMermaid);
  renderMermaid(document);
</script>
