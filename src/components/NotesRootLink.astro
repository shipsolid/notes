---
import type { CollectionEntry } from 'astro:content';

interface Props {
  rootNotes: CollectionEntry<'notes'>[];
  rootLabel: string;
}

const { rootNotes, rootLabel } = Astro.props;
---

{rootNotes.length === 1 ? (
  <a
    href={`/notes/${rootNotes[0].id}`}
    class="flex items-start justify-between gap-2 px-3 py-2 rounded-lg text-xs font-mono text-dim hover:text-ink hover:bg-surface-hover/60 transition-colors no-underline"
  >
    <span class="leading-snug">{rootLabel}</span>
  </a>
) : (
  <details>
    <summary class="flex items-center gap-1.5 px-3 py-2.5 rounded-lg text-sm text-muted hover:text-ink hover:bg-surface-hover/50 transition cursor-pointer">
      <span class="tree-chevron shrink-0 text-faint transition-transform duration-150" aria-hidden="true">▸</span>
      <span class="flex-1 min-w-0 break-words">{rootLabel}</span>
      <span class="text-xs font-mono text-faint shrink-0">{rootNotes.length}</span>
    </summary>
    <div class="mt-1 flex flex-col gap-1">
      {rootNotes.map((note) => (
        <a
          href={`/notes/${note.id}`}
          class="block pl-6 pr-3 py-1.5 rounded-lg text-xs text-faint hover:text-body hover:bg-surface-hover/30 transition no-underline break-words"
        >
          {note.data.title}
        </a>
      ))}
    </div>
  </details>
)}

<style>
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] > summary .tree-chevron {
    transform: rotate(90deg);
  }
</style>
